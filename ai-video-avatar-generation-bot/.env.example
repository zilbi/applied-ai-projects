# Required credentials. Keep real values only in .env.
TELEGRAM_BOT_TOKEN=
GIGACHAT_AUTH_KEY=
HEYGEN_API_KEY=

# GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_CERT_PATH=./russian_trusted_root_ca_pem.crt

# HeyGen
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_WIDTH=1280
HEYGEN_HEIGHT=720
HEYGEN_AVATAR_OFFICIAL_ID=
HEYGEN_AVATAR_FRIENDLY_ID=
HEYGEN_AVATAR_ENERGETIC_ID=
HEYGEN_AVATAR_NEUTRAL_ID=
AVATAR_PERSON_NAME=

# Storage and speech recognition
DATABASE_URL=sqlite:///video_bot.db
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Runtime
LOG_LEVEL=INFO
MAX_TEXT_LENGTH=5000
POLL_INTERVAL_SECONDS=15
