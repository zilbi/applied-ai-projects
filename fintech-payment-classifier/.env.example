DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DB_PATH=results/webapp/webapp.sqlite3
DJANGO_UPLOAD_DIR=results/webapp/uploads
DJANGO_MAX_UPLOAD_MB=50
PYTHON_EXECUTABLE=
PIPELINE_RESULTS_DIR=results/runs

# Optional public-website fallback.  Keep the real key only in local .env.
TAVILY_ENABLED=false
TAVILY_API_KEY=
# Optional: leave blank unless this is a real Tavily project ID owned by the key.
TAVILY_PROJECT_ID=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_COUNTRY=russia
TAVILY_TIMEOUT_SECONDS=30
TAVILY_CONNECT_TIMEOUT_SECONDS=10
TAVILY_MAX_RETRIES=2
TAVILY_MAX_CALLS_PER_COMPANY=2
TAVILY_MAX_CREDITS_PER_RUN=50
TAVILY_MONTHLY_SOFT_LIMIT=900
TAVILY_ALLOW_PAID=false
TAVILY_REQUIRE_USAGE_PREFLIGHT=true
