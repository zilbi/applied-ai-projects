APP_ENV=local

# Local database values. Replace the password before starting the stack.
DATABASE_URL=postgresql+asyncpg://csm_user:replace_with_a_local_password@localhost:5432/csm_assistant
POSTGRES_DB=csm_assistant
POSTGRES_USER=csm_user
POSTGRES_PASSWORD=replace_with_a_local_password

# Optional integrations. Keep real credentials only in a local .env file.
TELEGRAM_BOT_TOKEN=

GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt

WHISPER_MODE=local
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
VOICE_MAX_DURATION_SECONDS=120

AI_MAX_CONTEXT_CHARS=6000
API_BASE_URL=http://localhost:8000
